# Core web — copie para .env.local e preencha. NUNCA versione .env.local.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
# Chave publishable (sb_publishable_...) ou anon legada. Segura para o navegador: o acesso é limitado pelo RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# O Core web NÃO usa service_role. Não adicione essa chave aqui.

# Opcional — envio de proposta por e-mail. Sem isto, nada é enviado e a tela avisa (copie o link e compartilhe).
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM="Sua Empresa <propostas@seudominio.com.br>"
